{
  "name": "SOCIALIQ Master Workflow",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "socialiq",
        "responseMode": "responseNode"
      },
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "position": [250, 300]
    },
    {
      "parameters": {
        "url": "http://host.docker.internal:8000/api/v1/chat",
        "method": "POST",
        "jsonParameters": true,
        "bodyParametersJson": "={{ JSON.stringify({ message: ($json.body || $json).message, session_id: ($json.body || $json).session_id, tools: ($json.body || $json).tools }) }}"
      },
      "name": "Call SOCIALIQ API",
      "type": "n8n-nodes-base.httpRequest",
      "position": [500, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}"
      },
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "position": [750, 300]
    }
  ],
  "connections": {
    "Webhook": { "main": [[{ "node": "Call SOCIALIQ API", "type": "main", "index": 0 }]] },
    "Call SOCIALIQ API": { "main": [[{ "node": "Respond", "type": "main", "index": 0 }]] }
  }
}
