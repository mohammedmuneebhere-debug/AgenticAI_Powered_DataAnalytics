# SOCIALIQ Environment Configuration

# LLM (OpenAI)
OPENAI_API_KEY=your_openai_api_key
LLM_MODEL=gpt-4o-mini
# Max tokens for a single LLM completion
LLM_MAX_OUTPUT_TOKENS=700
# Per-request timeout (seconds) for structured JSON generation (remote 31B models can be slow)
LLM_JSON_TIMEOUT_SECONDS=240

# Ollama (LLM fallback / selectable model backend)
OLLAMA_BASE_URL=http://localhost:11434
# Any Ollama model tag — local (e.g. llama3.2) or cloud-routed (e.g. gemma4:31b-cloud)
OLLAMA_MODEL=gemma4:31b-cloud
# How long Ollama keeps the model loaded after a request (30m/1h/-1).
# Prevents 30-60s cold-start stalls after idle periods.
OLLAMA_KEEP_ALIVE=30m
# Auto-try Ollama when no OpenAI key is configured (true/false)
OLLAMA_AUTO_FALLBACK=true

# Synthetic data fallback: when retrieval comes back blank (no Google Trends
# regions, no trend topics, no relevant X posts), generate clearly-flagged
# placeholder data from the LLM, grounded in whatever context WAS retrieved.
# Disclosed in the API response via the synthetic_data metadata field.
SYNTHETIC_DATA_FALLBACK=true

# Web search tool-calling for the insight agent (live lookups)
WEB_SEARCH_MAX_RESULTS=6
# Comma-separated allowlist of domains the LLM can search (empty = all)
WEB_SEARCH_ALLOWED_DOMAINS=

# Database
# Used when JSON_FALLBACK=false (PostgreSQL persistence); the asyncpg URL is
# translated to the psycopg2 sync driver automatically by the store layer.
DATABASE_URL=postgresql://socialiq:socialiq@localhost:5432/socialiq
# true = JSON file stores (users/sessions), no Docker needed.
# false = PostgreSQL via SQLAlchemy + alembic (`alembic upgrade head`); if the
# database is unreachable the stores log a warning and degrade to JSON.
JSON_FALLBACK=true
REDIS_URL=redis://localhost:6379/0
# Analysis-result cache TTL in seconds (0 disables; Redis optional)
ANALYSIS_CACHE_TTL_SECONDS=900

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=socialiq123

# IPFS (provenance content storage; kubo API port)
IPFS_API_URL=http://localhost:5001

# ML backends
# Sentence-transformer model for embeddings (Phase 4)
EMBEDDING_MODEL=all-MiniLM-L6-v2
# Sentiment backend: vader (fast, default) or transformer (cardiffnlp RoBERTa, lazy-loaded)
ML_SENTIMENT_BACKEND=vader
# Optional Prophet-based trend forecasting (true/false)
TREND_FORECAST_ENABLED=false

# Social APIs
X_BEARER_TOKEN=
TELEGRAM_BOT_TOKEN=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
PINTEREST_ACCESS_TOKEN=
# SerpAPI (Google Search + Google Trends)
SERPAPI_API_KEY=
SERPAPI_GOOGLE_DOMAIN=google.com
# Apify (X/Twitter web scraping — pay-per-result, no X API needed)
# NOTE: the default actor permits API runs on the Apify Free plan.
APIFY_API_KEY=
APIFY_X_SCRAPER_ACTOR=kaitoeasyapi~twitter-x-data-tweet-scraper-pay-per-result-cheapest
APIFY_X_MAX_ITEMS=20
APIFY_TIMEOUT_SECONDS=90
SERPAPI_TRENDS_GEO=
SERPAPI_TRENDS_DATE=today 12-m
NEWS_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# n8n
N8N_WEBHOOK_URL=http://localhost:5678/webhook/socialiq
# Frontend browser URL for the n8n master webhook
NEXT_PUBLIC_N8N_WEBHOOK_URL=http://localhost:5678/webhook/socialiq
N8N_API_KEY=

# Backend
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated allowed origins, or a regex prefixed with regex: (e.g. "regex:http://localhost:\d+")
CORS_ORIGINS=http://localhost:3000

# Blockchain (prototype)
BLOCKCHAIN_MODE=local
BLOCKCHAIN_LEDGER_PATH=./data/ledger.json

# Data stores (JSON files; swap for Postgres in production)
USERS_STORE_PATH=./data/users.json
SESSIONS_STORE_PATH=./data/sessions.json

# Security
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
