# SOCIALIQ Environment Configuration

# LLM
OPENAI_API_KEY=your_openai_api_key
LLM_MODEL=gpt-4o-mini

# Database
DATABASE_URL=postgresql://socialiq:socialiq@localhost:5432/socialiq
REDIS_URL=redis://localhost:6379/0

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=socialiq123

# Social APIs
X_BEARER_TOKEN=
TELEGRAM_BOT_TOKEN=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
PINTEREST_ACCESS_TOKEN=
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=
NEWS_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# n8n
N8N_WEBHOOK_URL=http://localhost:5678/webhook/socialiq
# Frontend browser URL for the n8n master webhook
NEXT_PUBLIC_N8N_WEBHOOK_URL=http://localhost:5678/webhook/socialiq
N8N_API_KEY=

# Backend
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# Blockchain (prototype)
BLOCKCHAIN_MODE=local
BLOCKCHAIN_LEDGER_PATH=./data/ledger.json

# Security
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
