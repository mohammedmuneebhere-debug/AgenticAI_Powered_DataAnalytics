{
  "name": "SOCIALIQ NewsAPI Search",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "socialiq/news-search",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "news-search-webhook",
      "name": "News Search Request",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        260,
        300
      ],
      "webhookId": "socialiq-news-search"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://newsapi.org/v2/everything",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "q",
              "value": "={{ (($json.body || {}).query || '').trim() || 'artificial intelligence' }}"
            },
            {
              "name": "language",
              "value": "={{ (($json.body || {}).language || 'en').trim() }}"
            },
            {
              "name": "sortBy",
              "value": "={{ (($json.body || {}).sort_by || 'relevancy').trim() }}"
            },
            {
              "name": "pageSize",
              "value": "={{ Math.min(Math.max(Number(($json.body || {}).page_size || 10), 1), 100) }}"
            },
            {
              "name": "from",
              "value": "={{ (($json.body || {}).from || '').trim() }}"
            },
            {
              "name": "apiKey",
              "value": "={{ $env.NEWS_API_KEY }}"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "newsapi-everything",
      "name": "Search NewsAPI",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        520,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const response = $json;\nconst articles = Array.isArray(response.articles) ? response.articles : [];\n\nreturn [{\n  json: {\n    status: response.status || 'error',\n    total_results: Number(response.totalResults || articles.length),\n    query: $('News Search Request').first().json.body?.query || 'artificial intelligence',\n    articles: articles.map((article) => ({\n      source: article.source?.name,\n      author: article.author,\n      title: article.title,\n      description: article.description,\n      content: article.content,\n      url: article.url,\n      image_url: article.urlToImage,\n      published_at: article.publishedAt\n    }))\n  }\n}];"
      },
      "id": "newsapi-normalize",
      "name": "Normalize News Articles",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        780,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}"
      },
      "id": "news-search-response",
      "name": "Return News Results",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1040,
        300
      ]
    }
  ],
  "connections": {
    "News Search Request": {
      "main": [
        [
          {
            "node": "Search NewsAPI",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Search NewsAPI": {
      "main": [
        [
          {
            "node": "Normalize News Articles",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Normalize News Articles": {
      "main": [
        [
          {
            "node": "Return News Results",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {},
  "versionId": "socialiq-news-search-v1",
  "meta": {
    "templateCredsSetupCompleted": true
  },
  "pinData": {}
}
